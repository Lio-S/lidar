# Données brutes : ignorées par DVC lui-même (data/raw/.gitignore créé par dvc add)
# Ne pas ignorer data/raw/ ici — DVC gère ses propres .gitignore dans data/

# Environnement Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Logs
logs/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Secrets GCP / OAuth — ne jamais commiter
client_secret_*.json
*-key.json
*.iam.gserviceaccount.com*.json

# Base DuckDB locale — régénérée par python -m lidar_arch.db.schema (versionnée via DVC si besoin)
data/*.duckdb
data/*.duckdb.wal
