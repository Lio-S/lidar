{
  "name": "archaeo-lidar",
  "build": {
    "dockerfile": "../Dockerfile",
    "target": "dev"
  },
  // Session VS Code en utilisateur non-root (uid 1000 = utilisateur WSL2) :
  // les fichiers créés dans le workspace appartiennent à l'utilisateur de l'hôte.
  // L'entrypoint (root) donne à ubuntu l'accès au socket Docker — voir docker/dev-entrypoint.sh
  "remoteUser": "ubuntu",
  // Garder l'ENTRYPOINT de l'image : par défaut VS Code le remplace par /bin/sh,
  // et docker/dev-entrypoint.sh (accès au socket Docker) ne s'exécuterait jamais
  "overrideCommand": false,
  // PID 1 = docker-init : arrêt propre du container (sleep ignore SIGTERM), processus orphelins nettoyés
  "init": true,
  // --network=host : le container voit l'API minikube publiée sur 127.0.0.1 de WSL2
  "runArgs": ["--network=host"],
  "mounts": [
    "source=${localWorkspaceFolder}/data,target=/app/data,type=bind",
    // Docker Engine de WSL2 → minikube (driver docker) depuis le container
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    // État minikube + kubeconfig conservés entre rebuilds du container
    // (volumes « -ubuntu » : les anciens lidar-minikube/lidar-kube appartenaient à root)
    "source=lidar-minikube-ubuntu,target=/home/ubuntu/.minikube,type=volume",
    "source=lidar-kube-ubuntu,target=/home/ubuntu/.kube,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "hashicorp.terraform",
        "ms-kubernetes-tools.vscode-kubernetes-tools"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/app/.venv/bin/python3",
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  // À chaque démarrage : minikube + port-forwards MLflow (5000) / Grafana (3000) / Prometheus (9090)
  "postStartCommand": "bash .devcontainer/post-start.sh",
  // Installe lidar_arch en éditable depuis le workspace monté (deps déjà dans l'image)
  "postCreateCommand": "uv sync --frozen --extra dev && python3 -m ipykernel install --user --name archaeo-lidar --display-name 'Python (archaeo-lidar)'"
}
